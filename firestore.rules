rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // One document per finished game: { json: string, startedAt: string }
    match /users/{uid}/sessions/{sid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['json', 'startedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 60000
        && request.resource.data.startedAt is string
        && request.resource.data.startedAt.size() < 40;
    }

    // Profile: { json: string, updatedAt: number }
    match /users/{uid}/meta/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 150000
        && request.resource.data.updatedAt is number;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
